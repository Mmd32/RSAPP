# ---------------------------------------------------------------------------
# Backend (server/src/index.ts)
# ---------------------------------------------------------------------------

# Port the API listens on. Most managed hosts inject this automatically.
PORT=3001

# Interface to bind. Keep 0.0.0.0 on any container/managed host.
HOST=0.0.0.0

# Writable directory for JSON stores, logs and uploads. Point this at a
# mounted volume so data survives redeploys (e.g. /data on Railway or Fly.io).
DATA_DIR=data

# Serve the built frontend (dist/) from the API process, so one service hosts
# the whole app on a single origin. Set to "false" to run an API-only service.
SERVE_CLIENT=true

# Comma-separated browser origins allowed to call the API. Leave empty when the
# frontend is served from the same origin as the API.
# ALLOWED_ORIGINS=https://rsapp.example.com,https://rsapp.pages.dev

# HMAC secret for signed upload/download URLs. Generate a fresh random value
# before any non-local deployment: openssl rand -hex 32
STORAGE_SIGNING_SECRET=change-me-before-deploying

# ---------------------------------------------------------------------------
# Frontend (build-time, baked into the bundle by Vite)
# ---------------------------------------------------------------------------

# Only needed when the frontend is hosted separately from the API. Leave unset
# for single-origin deployments, where the relative /api prefix is correct.
# VITE_API_BASE_URL=https://rsapp-api.onrender.com/api
